; ftdi_winusb_simple.inf
; Simplified WinUSB driver for FTDI FT4232H Interface 0 (RS232 JTAG)
; Modern Windows 10/11 compatible - No CoInstaller needed
; Copyright (c) 2024 DMATool

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGuid   = {88bae032-5a81-49f0-bc3d-a4ff138216d6}
Provider    = %ManufacturerName%
CatalogFile = ftdi_winusb_simple.cat
DriverVer   = 12/12/2024,1.0.0.0

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]
%DeviceName% = USB_Install, USB\VID_0403&PID_6011&MI_00

[USB_Install.NT]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install.NT.Services]
Include    = winusb.inf
AddService = WinUSB,0x00000002,WinUSB_ServiceInstall

[WinUSB_ServiceInstall]
DisplayName   = %ServiceName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WinUSB.sys

[USB_Install.NT.Wdf]
KmdfService = WINUSB, WinUsb_Install

[WinUSB_Install]
KmdfLibraryVersion = 1.11

[USB_Install.NT.HW]
AddReg = Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{F5A093DC-02B2-4ACA-A9AB-8E44DC8AE3F7}"

[Strings]
ManufacturerName = "DMATool"
DeviceName       = "FTDI FT4232H (Interface 0 - JTAG)"
ServiceName      = "WinUSB Driver for FTDI JTAG"
